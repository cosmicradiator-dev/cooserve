# ==============================================================================
# COOPERATIVE GIG SERVICES PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: In production environments (Vercel, AWS, Cloud Run, Docker, Kubernetes),
# store sensitive secrets (SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, etc.)
# in your hosting platform's encrypted Secrets Manager / Environment Variables panel.
# Never commit actual secret keys or credentials to Git repositories.
# ==============================================================================

# Node Runtime Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Application Deployment URL
# ------------------------------------------------------------------------------
# Set this to your primary production domain (e.g., https://cooserve.org or Vercel URL)
# Ensure HTTPS is enforced on this domain.
NEXT_PUBLIC_APP_URL=https://cooserve.org

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# ------------------------------------------------------------------------------
# Active Supabase Project endpoint
NEXT_PUBLIC_SUPABASE_URL=https://nwapyyailprjmprfwbnm.supabase.co

# Supabase Public Anonymous / Publishable Key
# Safe to expose in the browser client bundle; access governed by Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__7lx6-f80oxcJPQDzBN_dQ_3Kscm8Lj
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__7lx6-f80oxcJPQDzBN_dQ_3Kscm8Lj

# Supabase Server Service Role Key (STRICTLY CONFIDENTIAL)
# NEVER prefix with NEXT_PUBLIC_! Used only in server API routes & workers to bypass RLS.
# Retrieve from: Supabase Dashboard > Project Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJh...your_production_service_role_key_here

# Supabase Database Direct & Pooled URLs (for Prisma, Drizzle, or Migrations if needed)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nwapyyailprjmprfwbnm.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Live Production Credentials)
# ------------------------------------------------------------------------------
# In production, use your live credentials prefixed with 'rzp_live_'
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_live_key_id

# Server-only Razorpay secret key for signature verification & escrow capture
RAZORPAY_KEY_SECRET=your_production_razorpay_key_secret

# Razorpay Webhook Secret for validating payment.captured and transfer.processed hooks
# Set the exact secret configured in your Razorpay Dashboard Webhooks setting
RAZORPAY_WEBHOOK_SECRET=your_production_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 4. Upstash Redis (Edge Rate Limiting & PostGIS Cache)
# ------------------------------------------------------------------------------
# Production REST URL & Token from Upstash Console (Serverless Redis)
# Used for sliding window rate limiting (Auth: 20 req/min, APIs: 100 req/min)
# and caching nearby worker lookups.
UPSTASH_REDIS_REST_URL=https://your-production-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_production_upstash_rest_token

# ------------------------------------------------------------------------------
# 5. Sentry Real-Time Error Tracking & Performance APM
# ------------------------------------------------------------------------------
# Sentry DSN for capturing unhandled runtime exceptions across Client, Server, and Edge
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_public_key@o0.ingest.sentry.io/your_project_id

# Sentry Auth Token used during CI/CD builds to upload source maps
SENTRY_AUTH_TOKEN=your_sentry_ci_auth_token

# Sentry Organization & Project identifiers (used by Next.js Sentry Webpack Plugin)
SENTRY_ORG=cooserve
SENTRY_PROJECT=marketplace-web

# ------------------------------------------------------------------------------
# 6. Hybrid Mobile Native Container (Capacitor / Android / iOS)
# ------------------------------------------------------------------------------
# Target URL for mobile app wrapper live-reload or production webview
CAPACITOR_SERVER_URL=https://cooserve.org
